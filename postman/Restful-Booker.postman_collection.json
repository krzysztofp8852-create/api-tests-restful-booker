      "name": "00 Health",
      "item": [
        {
          "name": "TC-001 GET Ping — API is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-001: status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"TC-001: body contains Created\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Created\");",
                  "});",
                  "pm.test(\"Response time is under 3000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ping",
            "description": "Health check. Dokumentacja: GET /ping → 201 Created."
          }
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "TC-002 POST Create token — valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-002: status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC-002: JSON has a non-empty token\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.token).to.match(/^[a-z0-9]+$/i);",
                  "    pm.environment.set(\"token\", json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "description": "Tworzy token i zapisuje go do `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "TC-009 POST Auth — invalid password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-009: status is 200 (documented Restful Booker behaviour)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC-009: body has reason Bad credentials and no token\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.reason).to.eql(\"Bad credentials\");",
                  "    pm.expect(json).to.not.have.property(\"token\");",
                  "});"
                ]
              }
            }
