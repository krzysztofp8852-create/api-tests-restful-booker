                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "description": "Złe hasło. API zwraca 200 + { reason: Bad credentials } — tak jest w dokumentacji, nie 401.",
