      "name": "02 Create booking",
      "item": [
        {
          "name": "TC-003 POST Create booking — valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-003: status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC-003: bookingid is a number and is saved\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"bookingid\");",
                  "    pm.expect(json.bookingid).to.be.a(\"number\");",
                  "    pm.environment.set(\"bookingId\", String(json.bookingid));",
                  "});",
                  "pm.test(\"TC-003: payload is echoed\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "    pm.expect(json.booking.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "    pm.expect(json.booking.totalprice).to.eql(120);",
                  "    pm.expect(json.booking.bookingdates.checkin).to.eql(\"2026-09-01\");",
                  "    pm.expect(json.booking.bookingdates.checkout).to.eql(\"2026-09-05\");",
                  "    pm.expect(json.booking.additionalneeds).to.eql(\"Breakfast\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
